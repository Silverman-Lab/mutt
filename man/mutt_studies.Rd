\name{mutt_studies}
\alias{mutt_studies}
\title{List curated microbiome studies}
\usage{mutt_studies()}
\description{Lists study identifiers, modalities, data versions and release status
from the small pinned package manifest. It downloads no study data.}
\value{A data frame containing study_id, display_name, sequencing, load, status,
release_tag, data_version and size_bytes.}
